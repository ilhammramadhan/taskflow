# Copy this file to .env and fill in real values.
# DO NOT commit .env to git.

# PostgreSQL connection string (Neon / Supabase / local)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Untuk Neon: copy "Connection string (Pooled connection)" dari dashboard
DATABASE_URL="postgresql://user:password@host:5432/taskflow?sslmode=require"

# JWT secret — generate random string:
#   openssl rand -base64 32
JWT_SECRET="change-this-to-a-long-random-string"

# Port backend listens on. Local: 4000. Production: biasanya auto-set by platform (Railway/Render).
PORT=4000

# Allowed CORS origin. Pisahkan multiple URL dengan koma.
# Local dev:    http://localhost:5173
# Production:   tambahkan URL frontend, contoh:
#   CORS_ORIGIN=http://localhost:5173,https://taskflow-fe.vercel.app
CORS_ORIGIN="http://localhost:5173"

# Optional: set "production" untuk disable Prisma debug log
# NODE_ENV=production
